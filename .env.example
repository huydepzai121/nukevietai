# Ghi đè cấu hình cho docker-compose.yml. Chép thành .env rồi sửa nếu cần.
# Mọi giá trị đều đã có mặc định trong docker-compose.yml, không có .env vẫn chạy.

# Phiên bản PHP của container web. NukeViet 4.x nhận PHP 7.4 – 8.5.
PHP_VERSION=8.3

# Cổng HTTP trên máy thật. Đổi nếu 8088 đã bị chiếm.
HTTP_PORT=8088

# Cổng phpMyAdmin trên máy thật (vào thẳng bằng localhost, không cần file hosts).
PMA_PORT=8089

# Cổng MariaDB trên máy thật (để 3307 tránh đụng hstdt-docker đang dùng 3306).
DB_PORT=3307

# Tên CSDL tạo sẵn khi container MariaDB khởi động lần đầu.
DB_NAME=nukeviet

TZ=Asia/Ho_Chi_Minh
